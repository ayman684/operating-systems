#include <stdio.h>

#define MAX_PROCESSES 5
#define MAX_RESOURCES 3

// Function prototypes
int is_safe();
int request_resources(int process_num, int request[]);

// Available instances of each resource
int available[MAX_RESOURCES] = {3, 3, 2};

// Maximum demand of each process
int maximum[MAX_PROCESSES][MAX_RESOURCES] = {
    {7, 5, 3},
    {3, 2, 2},
    {9, 0, 2},
    {2, 2, 2},
    {4, 3, 3}
};

// Resources currently allocated to each process
int allocation[MAX_PROCESSES][MAX_RESOURCES] = {
    {0, 1, 0},
    {2, 0, 0},
    {3, 0, 2},
    {2, 1, 1},
    {0, 0, 2}
};

// Request resources function
int request_resources(int process_num, int request[]) {
    // Step 1: Check if request <= need and request <= available
    for (int i = 0; i < MAX_RESOURCES; i++) {
        int need = maximum[process_num][i] - allocation[process_num][i];
        if (request[i] > need || request[i] > available[i]) {
            return 0; // Request cannot be granted
        }
    }

    // Step 2: Pretend to allocate resources
    for (int i = 0; i < MAX_RESOURCES; i++) {
        available[i] -= request[i];
        allocation[process_num][i] += request[i];
    }

    // Step 3: Check if system is in safe state after allocation
    if (is_safe()) {
        return 1; // Request is granted
    } else {
        // Step 4: Roll back changes if not safe
        for (int i = 0; i < MAX_RESOURCES; i++) {
            available[i] += request[i];
            allocation[process_num][i] -= request[i];
        }
        return 0; // Request is denied
    }
}

// Safety algorithm to check for safe state
int is_safe() {
    int work[MAX_RESOURCES];
    int finish[MAX_PROCESSES] = {0};

    // Initialize work array with available resources
    for (int i = 0; i < MAX_RESOURCES; i++) {
        work[i] = available[i];
    }

    int count = 0;
    while (count < MAX_PROCESSES) {
        int found = 0;
        for (int i = 0; i < MAX_PROCESSES; i++) {
            if (finish[i] == 0) {
                int j;
                // Check if need of process i <= work
                for (j = 0; j < MAX_RESOURCES; j++) {
                    int need = maximum[i][j] - allocation[i][j];
                    if (need > work[j])
                        break;
                }

                if (j == MAX_RESOURCES) {
                    // Process can finish, release its resources
                    for (int k = 0; k < MAX_RESOURCES; k++) {
                        work[k] += allocation[i][k];
                    }
                    finish[i] = 1;
                    found = 1;
                    count++;
                }
            }
        }
        if (found == 0) {
            return 0; // No process can finish, unsafe state
        }
    }
    return 1; // All processes can finish, safe state
}

int main() {
    int process_num, request[MAX_RESOURCES];

    printf("Enter process number (0 to 4): ");
    scanf("%d", &process_num);

    printf("Enter resource request (e.g., 1 0 2): ");
    for (int i = 0; i < MAX_RESOURCES; i++) {
        scanf("%d", &request[i]);
    }

    if (request_resources(process_num, request)) {
        printf("Request granted.\n");
    } else {
        printf("Request denied. System would be in unsafe state.\n");
    }

    return 0;
}
