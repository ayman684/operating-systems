#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fptr1, *fptr2;
    char filename[100];
    int c; // Using int to correctly handle EOF

    // 1. Open the source file for reading
    printf("Enter the filename to open for reading \n");
    scanf("%s", filename);
    
    fptr1 = fopen(filename, "r");
    if (fptr1 == NULL)
    {
        printf("Cannot open file %s \n", filename);
        exit(0);
    }

    // 2. Open the destination file for writing
    printf("Enter the filename to open for writing \n");
    scanf("%s", filename);
    
    fptr2 = fopen(filename, "w");
    if (fptr2 == NULL)
    {
        printf("Cannot open file %s \n", filename);
        exit(0);
    }

    // 3. Copy character by character until End of File (EOF)
    c = fgetc(fptr1);
    while (c != EOF)
    {
        fputc(c, fptr2);
        c = fgetc(fptr1);
    }

    printf("\nContents copied to %s", filename);

    // 4. Close both files and exit
    fclose(fptr1);
    fclose(fptr2);
    return 0;
}
