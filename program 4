#include <stdio.h>

int main() {
    int bt[20], p[20], wt[20], tat[20], i, j, n, pos, temp;
    float total_wt = 0, total_tat = 0;
    float avg_wt, avg_tat;

    printf("Enter number of process: ");
    scanf("%d", &n);

    printf("\nEnter Burst Time:\n");
    for (i = 0; i < n; i++) {
        printf("p%d: ", i + 1);
        scanf("%d", &bt[i]);
        p[i] = i + 1; // Contains process numbers
    }

    // Sorting burst times in ascending order using Selection Sort
    for (i = 0; i < n; i++) {
        pos = i;
        for (j = i + 1; j < n; j++) {
            if (bt[j] < bt[pos]) {
                pos = j;
            }
        }

        // Swap burst time
        temp = bt[i];
        bt[i] = bt[pos];
        bt[pos] = temp;

        // Swap process IDs alongside burst times
        temp = p[i];
        p[i] = p[pos];
        p[pos] = temp;
    }

    // Waiting time for first process is 0
    wt[0] = 0;

    // Calculate waiting time for all processes
    for (i = 1; i < n; i++) {
        wt[i] = 0;
        for (j = 0; j < i; j++) {
            wt[i] += bt[j];
        }
        total_wt += wt[i];
    }

    avg_wt = total_wt / n;

    // Calculate turnaround time and print results in a structured table
    printf("\nProcess\t    Burst Time    Waiting Time\tTurnaround Time");
    for (i = 0; i < n; i++) {
        tat[i] = bt[i] + wt[i]; // Turnaround time = Burst time + Waiting time
        total_tat += tat[i];
        printf("\np%d\t\t%d\t\t%d\t\t%d", p[i], bt[i], wt[i], tat[i]);
    }

    avg_tat = total_tat / n;

    printf("\n\nAverage Waiting Time = %f", avg_wt);
    printf("\nAverage Turnaround Time = %f\n", avg_tat);

    return 0;
}
