#include <stdio.h>

int main() {
    int i, NOP, sum = 0, count = 0, y, quant, wt = 0, tat = 0;
    int at[10], bt[10], temp[10];
    float avg_wt, avg_tat;

    printf("Total number of processes in the system: ");
    if (scanf("%d", &NOP) != 1) return 1;

    y = NOP; // Initialize remaining processes count

    // Input Arrival and Burst times
    for (i = 0; i < NOP; i++) {
        printf("\nEnter the Arrival and Burst time of the Process[%d]\n", i + 1);
        printf("Arrival time is: ");
        if (scanf("%d", &at[i]) != 1) return 1;
        printf("Burst time is: ");
        if (scanf("%d", &bt[i]) != 1) return 1;
        temp[i] = bt[i]; // Store original burst times in a temporary array
    }

    printf("\nEnter the Time Quantum for the process: ");
    if (scanf("%d", &quant) != 1) return 1;

    // Display Table Header
    printf("\nProcess No\tBurst Time\tTAT\tWaiting Time\n");

    // Round Robin Logic Loop
    for (sum = 0, i = 0; y != 0; ) {
        if (temp[i] <= quant && temp[i] > 0) {
            sum = sum + temp[i];
            temp[i] = 0;
            count = 1;
        } else if (temp[i] > 0) {
            temp[i] = temp[i] - quant;
            sum = sum + quant;
        }

        // Process finishes execution
        if (temp[i] == 0 && count == 1) {
            y--; // One less process remaining
            printf("Process No[%d]\t\t%d\t\t%d\t\t%d\n", i + 1, bt[i], sum - at[i], sum - at[i] - bt[i]);
            wt = wt + (sum - at[i] - bt[i]);
            tat = tat + (sum - at[i]);
            count = 0;
        }

        // Cycle through the ready queue sequentially
        if (i == NOP - 1) {
            i = 0;
        } else if (at[i + 1] <= sum) {
            i++;
        } else {
            i = 0;
        }
    }

    // Calculate and print averages
    avg_wt = wt * 1.0 / NOP;
    avg_tat = tat * 1.0 / NOP;

    printf("\nAverage Turn Around Time: \t%.2f", avg_tat);
    printf("\nAverage Waiting Time: \t%.2f\n", avg_wt);

    return 0;
}
